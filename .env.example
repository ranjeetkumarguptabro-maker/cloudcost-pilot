# CloudCost Pilot - Environment Configuration Template
# Copy this file to .env and configure for your environment.
# IMPORTANT: Never commit .env containing actual secrets or keys to Git.

# AWS Configuration
# AWS_PROFILE: Named profile from ~/.aws/credentials. If omitted, default credential chain is used.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
COST_EXPLORER_REGION=us-east-1

# Application Settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# Storage Paths (relative to project root or absolute)
DATA_DIR=data
REPORTS_DIR=reports
